\uc0\u44048 \u46021 \u51060  \u51104 \u51221  \u49440 \u53469 \u51012  \u47564 \u46308 \u47732 , \u51032 \u46020 \u47484  \u52264 \u45800 \u54620  reader agent\u44032  \u44208 \u51221 \u46108  \u53080 \u54000  \u49884 \u53248 \u49828 \u47484  \u49692 \u52264 \u51201 \u51004 \u47196  \u51069 \u45716 \u45796 . reader\u45716  \u44033  \u54056 \u45328 \u50640 \u49436  \u47924 \u50631 \u51012  \u51060 \u54644 \u54664 \u45716 \u51648 , \u50612 \u46500  \u44048 \u51221 \u44284  \u49324 \u44148  \u44288 \u44228 \u47484  \u52628 \u47200 \u54664 \u45716 \u51648 , \u50612 \u46500  \u51221 \u48372 \u44032  \u47749 \u54869 \u54616 \u44144 \u45208  \u47784 \u54840 \u54664 \u45716 \u51648 \u47484  \u48372 \u44256 \u54620 \u45796 . \u51060  \u51069 \u44592 \u45716  \u44048 \u46021 \u51060  \u51032 \u46020 \u54620  \u51032 \u48120 \u50752  \u51228 3\u51088 \u50640 \u44172  \u51204 \u45804 \u46108  \u51032 \u48120  \u49324 \u51060 \u51032  \u44201 \u52264 \u47484  \u46300 \u47084 \u45236 \u47728 , \u45796 \u51020  \u46972 \u50868 \u46300 \u50640 \u49436  \u49352 \u47196 \u50868  \u51228 \u50557 \u51004 \u47196  \u49324 \u50857 \u46108 \u45796 .\
